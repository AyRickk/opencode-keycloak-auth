{
  "name": "opencode-keycloak-auth",
  "version": "1.0.0",
  "description": "OpenCode auth plugin: OAuth2/OIDC against Keycloak (Authorization Code + PKCE S256 and Device Authorization Grant) for an OpenAI-compatible provider.",
  "type": "module",
  "license": "MIT",
  "author": "AyRickk (https://github.com/AyRickk)",
  "homepage": "https://github.com/AyRickk/opencode-keycloak-auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AyRickk/opencode-keycloak-auth.git"
  },
  "bugs": {
    "url": "https://github.com/AyRickk/opencode-keycloak-auth/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "keycloak",
    "oidc",
    "oauth2",
    "openid-connect",
    "pkce",
    "device-flow",
    "auth",
    "sso"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "server.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/check-bundle.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode-ai/plugin": "^1.17.11",
    "@opencode/plugin": "2.0.25",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
